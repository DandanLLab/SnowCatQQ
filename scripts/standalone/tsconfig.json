/**
 * tsx 运行配置：只给 scripts/ 与测试脚本用。
 *
 * 目的：把仓库 tsconfig.base.json 的 paths 别名（@/snowcat-core/* 等）映射
 * 成真实包路径，让独立客户端入口可以纯 ESM 直跑生产 TS 源码（无 QQ 壳）。
 * 不影响 packages 自身的 typecheck/build（各自有专属 tsconfig）。
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["./**/*.ts", "../../packages/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
